# Copy to .env (gitignored). Values already set in the shell take precedence.

# Phoenix Cloud space (the same values scripts/export_trace.py reads as PHOENIX_ENDPOINT / PHOENIX_API_KEY)
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/<space>
PHOENIX_API_KEY=

# Judge endpoint for scripts/judge_heartbeats.py: any OpenAI-compatible chat server
HEARTBEAT_JUDGE_BASE_URL=http://dgx-spark:8002/v1
HEARTBEAT_JUDGE_MODEL=qwen3.5-122b-a10b
HEARTBEAT_JUDGE_PROVIDER=vllm
HEARTBEAT_JUDGE_API_KEY_ENV=SPARK_API_KEY
SPARK_API_KEY=

# For GPT judge runs, override all four settings together:
# HEARTBEAT_JUDGE_PROVIDER=openai
# HEARTBEAT_JUDGE_BASE_URL=https://api.openai.com/v1
# HEARTBEAT_JUDGE_MODEL=gpt-6-sol
# HEARTBEAT_JUDGE_API_KEY_ENV=OPENAI_API_KEY
# OPENAI_API_KEY=

# scripts/extract_heartbeats.py: where the assistant's transcript store lives (never committed; .env is gitignored)
OPENCLAW_SSH_HOST=user@host-or-tailscale-ip
OPENCLAW_HOME=~/.openclaw
OPENCLAW_MAIN_SESSION=
