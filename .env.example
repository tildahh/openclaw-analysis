# Copy to .env

# Phoenix Cloud space. Both endpoints take the same URL: scripts/export_trace.py reads PHOENIX_ENDPOINT,
# evals/judge_heartbeats.py reads PHOENIX_COLLECTOR_ENDPOINT.
PHOENIX_ENDPOINT=https://app.phoenix.arize.com/s/<space>
PHOENIX_COLLECTOR_ENDPOINT=https://app.phoenix.arize.com/s/<space>
PHOENIX_API_KEY=

# Judge endpoint for locally hosted judge models in evals/judge_heartbeats.py
# HEARTBEAT_JUDGE_BASE_URL=http://dgx-spark:800X/v1
# HEARTBEAT_JUDGE_MODEL=qwen3.5-122b-a10b
# HEARTBEAT_JUDGE_PROVIDER=vllm
# HEARTBEAT_JUDGE_API_KEY_ENV=SPARK_API_KEY
# SPARK_API_KEY=
# OPENAI_API_KEY=

# For GPT judge runs, override all four settings together:
HEARTBEAT_JUDGE_PROVIDER=openai
HEARTBEAT_JUDGE_BASE_URL=https://api.openai.com/v1
HEARTBEAT_JUDGE_MODEL=
HEARTBEAT_JUDGE_API_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=
