!/scripts/prepare_task_workspace.py
!/scripts/run_clean_trial.py
!/scripts/export_cookbook.py
!/scripts/export_trace.py

!/observer/
/observer/node_modules/
!/prompts/

!/policies/
/policies/*
!/policies/heartbeat-words-live.md
!/policies/heartbeat-words-fixed.md

!/results/
/results/*
!/results/labels.csv
!/results/judge_holdout.csv
!/results/heartbeats_2026-09-28.csv
!/results/summary.json
!/results/task_human_review.csv

!/docs/
